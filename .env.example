# Postgres (matches docker-compose.yml). asyncpg driver for the app.
DATABASE_URL=postgresql+asyncpg://interview:interview@localhost:5433/interview_platform

# OpenRouter (https://openrouter.ai/keys) — used for resume structuring.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Swappable per task later; one cheap general-purpose model for now.
OPENROUTER_MODEL=openai/gpt-4o-mini

# Where uploaded resumes are saved for local dev (swapped for GCS in the cloud deploy milestone).
RESUME_STORAGE_DIR=./data/resumes
